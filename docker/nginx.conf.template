user  www-data;
worker_processes  auto;
pid /run/nginx.pid;

events {
    worker_connections  2048;
    multi_accept        on;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;

    sendfile      on;
    tcp_nopush    on;
    tcp_nodelay   on;

    keepalive_timeout  65;
    server_tokens      off;

    client_max_body_size 32M;
    client_body_buffer_size 128k;

    gzip              on;
    gzip_vary         on;
    gzip_comp_level   5;
    gzip_min_length   256;
    gzip_proxied      any;
    gzip_types        text/plain text/css text/javascript application/javascript
                      application/json application/xml image/svg+xml font/woff font/woff2;

    access_log /dev/stdout;
    error_log  /dev/stderr warn;

    # PHP treats any non-empty HTTPS value as secure, so "http" must map to "".
    map $http_x_forwarded_proto $fastcgi_https {
        default "";
        https   on;
    }

    upstream php-fpm {
        server 127.0.0.1:9000;
        keepalive 32;
    }

    server {
        listen ${PORT} default_server;
        server_name _;
        root /app/public;
        index index.php;

        charset utf-8;

        # ^~ so the css/js regex below doesn't take precedence over this.
        location ^~ /build/ {
            access_log off;
            add_header Cache-Control "public, max-age=31536000, immutable";
            try_files $uri =404;
        }

        location ~* \.(?:css|js|jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot)$ {
            access_log off;
            add_header Cache-Control "public, max-age=2592000";
            try_files $uri /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        location / {
            try_files $uri $uri/ /index.php?$query_string;
        }

        # Front controller only — /storage symlinks to uploads whose extension
        # comes from the client, so a broad \.php$ match would execute them.
        location ~ ^/index\.php(/|$) {
            fastcgi_pass php-fpm;
            fastcgi_index index.php;
            include fastcgi_params;

            fastcgi_split_path_info ^(.+\.php)(/.*)$;
            fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
            fastcgi_param PATH_INFO       $fastcgi_path_info;
            fastcgi_param HTTPS           $fastcgi_https if_not_empty;
            # Debian's fastcgi_params maps HTTP_HOST to $host, which drops the
            # port, so Laravel builds asset URLs without it on non-standard ports.
            fastcgi_param HTTP_HOST       $http_host;

            fastcgi_keep_conn      on;
            fastcgi_read_timeout   120s;
            fastcgi_buffer_size    32k;
            fastcgi_buffers        16 32k;
            fastcgi_busy_buffers_size 64k;
        }

        location ~ \.php$ {
            return 404;
        }

        location ~ /\.(?!well-known).* {
            deny all;
        }
    }
}
