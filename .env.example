APP_NAME=jiidaa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

# Google OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Paystack Payment Configuration
PAYSTACK_SECRET_KEY=

# Stellar SEP-24 Anchor (testnet). Populate the issuer/distribution/signing values
# from docker/anchor/accounts.generated.env.
STELLAR_NETWORK=testnet
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_ANCHOR_BASE_URL=http://localhost:8080
STELLAR_ANCHOR_HOME_DOMAIN=localhost:8080
STELLAR_ANCHOR_SEP10_SIGNING=
STELLAR_NGNC_ASSET_CODE=NGNC
STELLAR_NGNC_ISSUER=
# Soroban RPC + the deployed NGNC SAC id — used by recurring MPP subscription charges.
# Derive the SAC id from the NGNC asset:
#   stellar contract id asset --asset NGNC:$STELLAR_NGNC_ISSUER --network testnet
STELLAR_SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NGNC_SAC=
STELLAR_PLATFORM_DISTRIBUTION_PUBLIC=
# Jiidaa's wallet that receives Anchor (SEP-24) subscription payments (from accounts.generated.env).
STELLAR_PLATFORM_WALLET_PUBLIC=
STELLAR_PLATFORM_WALLET_SECRET=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
# Set true only once the approved vendor_update template declares an IMAGE header.
WHATSAPP_TEMPLATE_VENDOR_UPDATE_IMAGE_HEADER=false
WHATSAPP_TEMPLATE_LEAD_ALERT=lead_alert

# Coins charged per unique buyer↔vendor introduction (30-day window).
# Fallback lead price when a vendor has no category tier and no override.
LEAD_DEFAULT_COST=5
# Warn a vendor once their balance falls below this many standard leads.
LEAD_LOW_BALANCE_LEADS=3
# Coin-burn guards: velocity thresholds and redirect rate limit.
GUARD_VELOCITY_BUYER_VENDORS=4
GUARD_VELOCITY_BUYER_MINUTES=5
GUARD_VELOCITY_IP_IDENTITIES=6
GUARD_VELOCITY_IP_MINUTES=10
GUARD_REDIRECT_MAX=5
GUARD_REDIRECT_SECONDS=60
# Purchased coins expire this many months after purchase, oldest first.
COIN_EXPIRY_MONTHS=12

CLAUDE_API_KEY=
CLAUDE_MODEL=claude-haiku-4-5-20251001

AI_BOT_DRIVER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side only: Places API (New) + Geocoding API. Restrict by IP.
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION_CODES=ng
